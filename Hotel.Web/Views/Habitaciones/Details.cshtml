@model Hotel.Web.Models.Habitacion

@{
    ViewData["Title"] = "Detalles de Habitación";
}

<h2>Detalles de Habitación</h2>

<div class="card p-4 mt-3">
    <dl class="row mb-0">
        <dt class="col-sm-3">Número</dt>
        <dd class="col-sm-9">@Model.Numero</dd>

        <dt class="col-sm-3">Piso</dt>
        <dd class="col-sm-9">@Model.Piso</dd>

        <dt class="col-sm-3">Tipo</dt>
        <dd class="col-sm-9">@Model.IdTipoHabitacionNavigation?.Nombre</dd>

        <dt class="col-sm-3">Precio por Noche</dt>
        <dd class="col-sm-9">S/ @(Model.IdTipoHabitacionNavigation?.PrecioNoche.ToString("F2") ?? "0.00")</dd>

        <dt class="col-sm-3">Estado</dt>
        <dd class="col-sm-9">
            <span class="badge @(Model.Activo ? "bg-success" : "bg-danger")">
                @(Model.Activo ? "Activa" : "Inactiva")
            </span>
        </dd>
    </dl>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.IdHabitacion" class="btn btn-warning">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la Lista</a>
</div>