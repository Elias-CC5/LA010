@model Hotel.Web.Models.Habitacion

@{
    ViewData["Title"] = "Eliminar Habitación";
}

<h2>¿Está seguro que desea eliminar la habitación?</h2>
<p class="text-muted">Se realizará una eliminación lógica (Activo = 0).</p>

<div class="card p-4 my-3">
    <dl class="row mb-0">
        <dt class="col-sm-3">Número</dt>
        <dd class="col-sm-9">@Model.Numero</dd>

        <dt class="col-sm-3">Piso</dt>
        <dd class="col-sm-9">@Model.Piso</dd>

        <dt class="col-sm-3">Tipo</dt>
        <dd class="col-sm-9">@Model.IdTipoHabitacionNavigation?.Nombre</dd>

        <dt class="col-sm-3">Precio por Noche</dt>
        <dd class="col-sm-9">S/ @(Model.IdTipoHabitacionNavigation?.PrecioNoche.ToString("F2") ?? "0.00")</dd>
    </dl>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="IdHabitacion" />
    <button type="submit" class="btn btn-danger">Confirmar Eliminación</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>