@model IEnumerable<Hotel.Web.Models.Habitacion>

@{
    ViewData["Title"] = "Gestión de Habitaciones";
}

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
        <div class="d-flex align-items-center">
            <i class="bi bi-check-circle-fill fs-5 me-2"></i>
            <div>@TempData["Mensaje"]</div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-3 border-bottom">
    <div>
        <h3 class="fw-bold text-dark m-0">Gestión de Habitaciones</h3>
        <p class="text-muted small m-0">Consulte y administre la disponibilidad de habitaciones registradas</p>
    </div>
    <a asp-controller="Habitaciones" asp-action="Create" class="btn btn-primary btn-pro shadow-sm d-inline-flex align-items-center gap-2">
        <i class="bi bi-plus-lg"></i>
        <span>Nueva Habitación</span>
    </a>
</div>

<!-- Barra de Filtros -->
<form method="get" asp-controller="Habitaciones" asp-action="Index" class="row g-3 mb-4 align-items-center">
    <div class="col-md-4">
        <div class="input-group shadow-sm rounded-3">
            <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-filter"></i></span>
            <select name="tipoId" asp-items="ViewBag.Tipos" class="form-select border-start-0 ps-0" onchange="this.form.submit()">
                <option value="">-- Todos los Tipos --</option>
            </select>
        </div>
    </div>
</form>

<!-- Tabla Estilizada -->
<div class="table-responsive rounded-3 border">
    <table class="table table-pro align-middle mb-0">
        <thead>
            <tr>
                <th>N° Habitación</th>
                <th>Piso</th>
                <th>Tipo de Habitación</th>
                <th>Precio / Noche</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-bold text-primary fs-6">
                        <i class="bi bi-door-closed me-1"></i>@item.Numero
                    </td>
                    <td>
                        <span class="badge bg-light text-dark border px-2 py-1">Piso @item.Piso</span>
                    </td>
                    <td class="fw-medium text-dark">
                        @item.IdTipoHabitacionNavigation?.Nombre
                    </td>
                    <td class="fw-bold text-success">
                        S/ @(item.IdTipoHabitacionNavigation?.PrecioNoche.ToString("F2") ?? "0.00")
                    </td>
                    <td class="text-end">
                        <div class="btn-group shadow-sm rounded-2 overflow-hidden" role="group">
                            <a asp-controller="Habitaciones" asp-action="Edit" asp-route-id="@item.IdHabitacion" class="btn btn-sm btn-outline-warning fw-semibold px-3">
                                <i class="bi bi-pencil me-1"></i> Editar
                            </a>
                            <a asp-controller="Habitaciones" asp-action="Details" asp-route-id="@item.IdHabitacion" class="btn btn-sm btn-outline-info fw-semibold px-3">
                                <i class="bi bi-eye me-1"></i> Detalles
                            </a>
                            <a asp-controller="Habitaciones" asp-action="Delete" asp-route-id="@item.IdHabitacion" class="btn btn-sm btn-outline-danger fw-semibold px-3">
                                <i class="bi bi-trash me-1"></i> Eliminar
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>