@model Hotel.Web.Models.Habitacion

@{
    ViewData["Title"] = "Editar Habitación";
}

<h2>Editar Habitación</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="IdHabitacion" />
    <input type="hidden" asp-for="Activo" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label class="form-label">Número</label>
        <input asp-for="Numero" class="form-control" />
        <span asp-validation-for="Numero" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Piso</label>
        <input asp-for="Piso" class="form-control" type="number" />
        <span asp-validation-for="Piso" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Tipo de Habitación</label>
        <select asp-for="IdTipoHabitacion" asp-items="ViewBag.IdTipoHabitacion" class="form-select"></select>
        <span asp-validation-for="IdTipoHabitacion" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Actualizar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>