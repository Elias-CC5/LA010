@model Hotel.Web.Models.Habitacion

@{
    ViewData["Title"] = "Crear Habitación";
}

<h2>Crear Nueva Habitación</h2>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label class="form-label">Número de Habitación</label>
        <input asp-for="Numero" class="form-control" placeholder="Ej. 101" />
        <span asp-validation-for="Numero" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Piso</label>
        <input asp-for="Piso" class="form-control" type="number" min="1" value="1" />
        <span asp-validation-for="Piso" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Tipo de Habitación</label>
        <select asp-for="IdTipoHabitacion" asp-items="ViewBag.IdTipoHabitacion" class="form-select">
            <option value="">-- Seleccione Tipo --</option>
        </select>
        <span asp-validation-for="IdTipoHabitacion" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>